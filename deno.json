{
  "nodeModulesDir": "none",
  "tasks": {
    "dev": "deno run -A npm:vite@^7.2.4",
    "build": "deno run -A npm:vite@^7.2.4 build",
    "preview": "deno run -A npm:vite@^7.2.4 preview",
    "check": "deno check src/main.tsx",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["vite/client"],
    "lib": ["esnext", "dom", "dom.iterable"],
    "strict": true
  },
  "lint": {
    "exclude": ["dist/", ".vite/"],
    "rules": {
      "exclude": ["no-window", "no-window-prefix", "jsx-button-has-type"]
    }
  },
  "fmt": {
    "exclude": ["dist/", ".vite/"]
  },
  "imports": {
    "@/": "./src/",
    "@deno/loader": "jsr:@deno/loader@^0.5.0",
    "esbuild": "npm:esbuild@^0.28.2",
    "cjs-module-lexer": "npm:cjs-module-lexer@^2.1.0",
    "vite": "npm:vite@^7.2.4",
    "vite/client": "npm:vite@^7.2.4/client",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^5.1.1",
